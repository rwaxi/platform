<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="RWAXI Architecture" id="id-bcce0fa301d14226b61463583fdc8d19" version="5.0.0">
  <folder name="Strategy" id="id-aff55a2e1ae64124b001d3a3d6edca1a" type="strategy"/>
  <folder name="Business" id="id-6bce4012184e4fdf8e3eb2c1c23eed21" type="business">
    <element xsi:type="archimate:BusinessActor" name="Investor" id="id-35b0419e83b344048dfd0980a37ac351"><documentation>Colombian or international. Passkey, KYC, USDC.</documentation></element>
    <element xsi:type="archimate:BusinessActor" name="RWAXI operator" id="id-9c356c297fae4c82a8519e7f5dc4f618"><documentation>Creates vehicles, approves investors, mints, pays out.</documentation></element>
    <element xsi:type="archimate:BusinessActor" name="Securities counsel" id="id-35cd8ba18f7a4a208253ad28b10a52a1"><documentation>Defines transfer rules per vehicle.</documentation></element>
  </folder>
  <folder name="Application" id="id-9e1f6f7381f840d8943695ad5e1d0afb" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="RWAXI Platform" id="id-bb8c46ce4ba3477194c0b124842d8b6c"><documentation>Issues and administers regulated RWA security tokens with on-chain compliance.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="SEP-24 anchor" id="id-74d530fd682e4bb18366751a40d08498"><documentation>External. COP &lt;-&gt; USDC.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="KYC/KYB provider" id="id-7bec1cf8277f45519dd9011a91162dfe"><documentation>External. Documents, liveness, AML.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="OZ Relayer - Channels" id="id-7070297bef084a70a6b979737cc01c13"><documentation>External. Submits tx, pays fees.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Stellar Expert" id="id-f1326dd8d0fb4141bfada86120856c50"><documentation>External. Public verification.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Investor app" id="id-b577a5efb07942ce9ec3a074fddcf0f6"><documentation>React Native / Expo. Passkey, KYC, subscribe, claim.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Backoffice" id="id-afd458250dbd40668fa0532b2380c3b8"><documentation>Next.js. Vehicles, approvals, payouts.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Platform API" id="id-4e4c6f6078c84aaea49da73e0d1d32d5"><documentation>NestJS / OpenAPI. Builds and simulates tx.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="KYC &amp; claim service" id="id-9160e7cc4a8c4f5c8a325a239475b174"><documentation>NestJS. Maps KYC to claims.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Event indexer" id="id-1d0a3b088a1a481c91d3118d0d0884fb"><documentation>Node worker. getEvents to DB.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Smart account" id="id-162940f77d5c40098b8ed7107a4c13b0"><documentation>OZ stellar-accounts. One per investor, passkey signer.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="rwa-token" id="id-608240b599c844ee93c70df4e52f6ba5"><documentation>OZ RWAToken, thin RWAXI wrapper. Per vehicle.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Compliance dispatcher" id="id-0dfe1410dea245418725b40e56dc411c"><documentation>OZ Compliance. Per vehicle. Registers modules per hook.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="subscription" id="id-c217545c70254ece86c177ad21e8c376"><documentation>Custom, per vehicle (T2). USDC escrow, soft/hard cap, refund.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="distribution" id="id-f0489875b7994031abffebaa5cf36e61"><documentation>Custom, per vehicle (T2). Pull-model USDC distribution.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Identity stack" id="id-0f20584f379747ff8446a9b20440feb2"><documentation>OZ, shared. Registry, claims, verifier.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="vehicle-factory" id="id-54a0fa6899194e2598faa5c83956885a"><documentation>Custom, shared. Deterministic salts; emits addresses of the new set.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="USDC" id="id-327b87c7bbaa4f99b5eb515a8d52f645"><documentation>Stellar Asset Contract.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="reg-s-distribution-period" id="id-fe46708c737e4db9ba5857c9b3daf126"><documentation>Custom (ADR-007). No tokens to US-related identities until period_end_ledger.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="country_restrict" id="id-cd097f5a7b9b481f97bc7954c6e6f9b3"><documentation>OZ module. Blocks listed countries.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="initial_lockup_period" id="id-a4d2386d85be48bfa9da020f8eb4143e"><documentation>OZ module.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="max_balance" id="id-28580fcad8564d949e20c48e0ccb1035"><documentation>OZ module.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="supply_limit" id="id-06adb2690ffa4f4b8e4912c9ae8062a5"><documentation>OZ module.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="balance-checkpoint" id="id-807d288d132746058c42caa97db9f65a"><documentation>Custom (T2). Bookkeeping of per-holder balance per epoch.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="identity-verifier" id="id-f446dc1879164c0083e2425a26297bed"><documentation>OZ. verify_identity(account).</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="identity-registry-storage" id="id-5cab1c6c3fd34202804a05474457f554"><documentation>OZ. wallet -&gt; identity + country data.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="claim-topics-and-issuers" id="id-d0f7ba23bcb94c92a87c3b1d3b77d67c"><documentation>OZ. Required topics, trusted issuers.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="identity contract" id="id-db5c27d5ea084eb7b3a29ed019616922"><documentation>OZ. One per investor.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="claim-issuer" id="id-b038c9ea8d764dc9ae8388902f3d1250"><documentation>OZ. Ed25519 key in KMS, revocation list.</documentation></element>
  </folder>
  <folder name="Technology &amp;amp; Physical" id="id-ad2fbbb100b340d0be33c5e3addeb3f0" type="technology">
    <element xsi:type="archimate:Node" name="Stellar network (Soroban)" id="id-1fd1b82fe9ef47c49c52b8f73a902a0d"><documentation>External. Token, identity and compliance contracts; USDC settlement.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Platform DB" id="id-fc91b0f562c145c5aeea530803b3dba9"><documentation>PostgreSQL (Cloud SQL, PITR).</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="KMS" id="id-fa91b9111604429c891de5d7b765e314"><documentation>GCP. Claim-issuer key.</documentation></element>
    <element xsi:type="archimate:Node" name="RWAXI off-chain (GCP)" id="id-e1b6f0ac16d74e089425e42573995cfc"><documentation>Cloud Run services, Cloud SQL, KMS.</documentation></element>
  </folder>
  <folder name="Motivation" id="id-650a7c4c7712479fa6e7b28dff0b6cc3" type="motivation"/>
  <folder name="Implementation &amp;amp; Migration" id="id-f62a2efd9a654ea8a2f9897bbb0c3b31" type="implementation_migration"/>
  <folder name="Other" id="id-1223e82de35e463995a827aa474d1985" type="other">
    <element xsi:type="archimate:Grouping" name="Clients" id="id-06bdd7657e374043a2acf059207361d2"/>
    <element xsi:type="archimate:Grouping" name="Per vehicle" id="id-67e9e071bc84420fb95999915ad63809"><documentation>Deployed by vehicle-factory.</documentation></element>
    <element xsi:type="archimate:Grouping" name="Compliance modules" id="id-5bc5567fc0824bb3a90e706acf3a3993"><documentation>Config per token.</documentation></element>
    <element xsi:type="archimate:Grouping" name="Identity stack (shared)" id="id-354eebabf71d4f39b4bc7eef0806ee7c"/>
  </folder>
